sct_image \
  -i $mcf_params_tx\
  -keep-vol ${run3_vol} \
  -o $(dirname ${run3})/regressors/$(basename ${run3::-7})_mc_params_mcf_tx.nii
sct_image \
  -i $mcf_params_ty\
  -keep-vol ${run3_vol} \
  -o $(dirname ${run3})/regressors/$(basename ${run3::-7})_mc_params_mcf_ty.nii
sct_image \
  -i $mcf_params_tz\
  -keep-vol ${run3_vol} \
  -o $(dirname ${run3})/regressors/$(basename ${run3::-7})_mc_params_mcf_tz.nii

# ------------------------------------------------------------------------------
# Create run4 files
run4_vol="$(seq -s ',' 1716 2144)"
sct_image \
  -i ${DIR_sub}/func_mc.nii.gz \
  -keep-vol ${run4_vol} \
  -o ${run4::-7}_mc.nii.gz \

sct_maths -i ${run4::-7}_mc.nii.gz -mean t -o ${run4::-7}_mc_mean.nii.gz

mkdir -pv $(dirname ${run4})/regressors
sct_image \
  -i $sct_params_x \
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_sct_x.nii
sct_image \
  -i $sct_params_y \
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_sct_y.nii
sct_image \
  -i $mcf_params_rx\
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_mcf_rx.nii
sct_image \
  -i $mcf_params_ry\
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_mcf_ry.nii
sct_image \
  -i $mcf_params_rz\
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_mcf_rz.nii
sct_image \
  -i $mcf_params_tx\
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_mcf_tx.nii
sct_image \
  -i $mcf_params_ty\
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_mcf_ty.nii
sct_image \
  -i $mcf_params_tz\
  -keep-vol ${run4_vol} \
  -o $(dirname ${run4})/regressors/$(basename ${run4::-7})_mc_params_mcf_tz.nii

# ------------------------------------------------------------------------------
rm ${DIR_sub}/temp*
