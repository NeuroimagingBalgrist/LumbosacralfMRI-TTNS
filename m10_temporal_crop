  -keep-vol ${vol_6min} \
  -o ${DIR_6min}/regressors/${NAME::-7}_params_mcf_ry.nii
sct_image \
  -i ${DIR_6min}/regressors/${NAME::-7}_params_mcf_rz.nii \
  -keep-vol ${vol_6min} \
  -o ${DIR_6min}/regressors/${NAME::-7}_params_mcf_rz.nii

sct_image \
  -i ${DIR_6min}/regressors/${NAME::-7}_params_mcf_tx.nii \
  -keep-vol ${vol_6min} \
  -o ${DIR_6min}/regressors/${NAME::-7}_params_mcf_tx.nii
sct_image \
  -i ${DIR_6min}/regressors/${NAME::-7}_params_mcf_ty.nii \
  -keep-vol ${vol_6min} \
  -o ${DIR_6min}/regressors/${NAME::-7}_params_mcf_ty.nii
sct_image \
  -i ${DIR_6min}/regressors/${NAME::-7}_params_mcf_tz.nii \
  -keep-vol ${vol_6min} \
  -o ${DIR_6min}/regressors/${NAME::-7}_params_mcf_tz.nii
