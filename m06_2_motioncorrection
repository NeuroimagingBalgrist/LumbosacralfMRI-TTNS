  -i $sct_params_x \
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_sct_x.nii
sct_image \
  -i $sct_params_y \
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_sct_y.nii
sct_image \
  -i $mcf_params_rx\
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_mcf_rx.nii
sct_image \
  -i $mcf_params_ry\
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_mcf_ry.nii
sct_image \
  -i $mcf_params_rz\
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_mcf_rz.nii
sct_image \
  -i $mcf_params_tx\
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_mcf_tx.nii
sct_image \
  -i $mcf_params_ty\
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_mcf_ty.nii
sct_image \
  -i $mcf_params_tz\
  -keep-vol ${run1_vol} \
  -o $(dirname ${run1})/regressors/$(basename ${run1::-7})_mc_params_mcf_tz.nii

# ------------------------------------------------------------------------------
# Create run2 files
run2_vol="$(seq -s ',' 858 1286)"
sct_image \
  -i ${DIR_sub}/func_mc.nii.gz \
  -keep-vol ${run2_vol} \
  -o ${run2::-7}_mc.nii.gz \

sct_maths -i ${run2::-7}_mc.nii.gz -mean t -o ${run2::-7}_mc_mean.nii.gz

mkdir -pv $(dirname ${run2})/regressors
sct_image \
  -i $sct_params_x \
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_sct_x.nii
sct_image \
  -i $sct_params_y \
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_sct_y.nii
sct_image \
  -i $mcf_params_rx\
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_mcf_rx.nii
sct_image \
  -i $mcf_params_ry\
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_mcf_ry.nii
sct_image \
  -i $mcf_params_rz\
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_mcf_rz.nii
sct_image \
  -i $mcf_params_tx\
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_mcf_tx.nii
sct_image \
  -i $mcf_params_ty\
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_mcf_ty.nii
sct_image \
  -i $mcf_params_tz\
  -keep-vol ${run2_vol} \
  -o $(dirname ${run2})/regressors/$(basename ${run2::-7})_mc_params_mcf_tz.nii

# ------------------------------------------------------------------------------
# Create run3 files
run3_vol="$(seq -s ',' 1287 1715)"
sct_image \
  -i ${DIR_sub}/func_mc.nii.gz \
  -keep-vol ${run3_vol} \
  -o ${run3::-7}_mc.nii.gz \

sct_maths -i ${run3::-7}_mc.nii.gz -mean t -o ${run3::-7}_mc_mean.nii.gz

mkdir -pv $(dirname ${run3})/regressors
sct_image \
  -i $sct_params_x \
  -keep-vol ${run3_vol} \
  -o $(dirname ${run3})/regressors/$(basename ${run3::-7})_mc_params_sct_x.nii
sct_image \
  -i $sct_params_y \
